[Unit]
Description=SingBox WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/singbox-webui
ExecStart=/opt/singbox-webui/singbox-webui -listen 0.0.0.0:9090 -data-dir ./
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
