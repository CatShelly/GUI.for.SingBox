# Put this map in nginx's http block.
map $http_upgrade $webui_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name singbox.example.com;
    ssl_certificate /etc/letsencrypt/live/singbox.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/singbox.example.com/privkey.pem;
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $webui_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
